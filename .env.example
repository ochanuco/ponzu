# Example environment file for Ponzu.
#
# This file is committed and must only ever contain non-secret placeholders
# (SECURITY.md, ADR-006). Real secrets, API tokens, and per-machine settings
# belong in the user's application data directory (DESIGN section 5.2), e.g.
# ~/Library/Application Support/Ponzu/secrets.env -- NEVER in this repository.

# Overrides the default macOS data directory
# (~/Library/Application Support/Ponzu) -- see ADR-006.
PONZU_DATA_DIR=

# Path to the user's config.yaml. Defaults to config.yaml inside
# PONZU_DATA_DIR if unset (DESIGN section 5.2).
PONZU_CONFIG=

# One of: debug, info, warning, error (DESIGN section 7).
PONZU_LOG_LEVEL=info
